  "openapi": "3.0.1",
  "info": {
    "title": "TechMove GLMS API",
    "description": "Global Logistics Management System REST API.\n\n**How to authenticate:**\n1. POST `/api/auth/login` with `{\"email\":\"admin@glms.com\",\"password\":\"Admin@123\"}`\n2. Copy the `token` from the response.\n3. Click **Authorize** and enter: `Bearer {token}`",
