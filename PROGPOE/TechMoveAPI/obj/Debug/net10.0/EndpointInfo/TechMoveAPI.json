                  "ServiceLevel",
                  "StartDate"
                ],
                "type": "object",
                "properties": {
                  "ClientId": {
                    "type": "string"
                  },
                  "StartDate": {
                    "type": "string"
                  },
                  "EndDate": {
                    "type": "string"
                  },
                  "ServiceLevel": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "Agreement": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "ClientId": {
                  "style": "form"
                },
                "StartDate": {
                  "style": "form"
                },
                "EndDate": {
                  "style": "form"
                },
                "ServiceLevel": {
                  "style": "form"
                },
                "Agreement": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
