# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project file and restore dependencies
COPY PROGPOE/PROGPOE.csproj PROGPOE/
RUN dotnet restore PROGPOE/PROGPOE.csproj

# Copy all source and publish
COPY PROGPOE/ PROGPOE/
RUN dotnet publish PROGPOE/PROGPOE.csproj -c Release -o /app/publish

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8080
ENTRYPOINT ["dotnet", "PROGPOE.dll"]
