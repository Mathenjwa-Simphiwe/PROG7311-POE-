<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechMove</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .api-btn { border: 1px solid rgba(255,255,255,.4); }
        .api-btn:hover { background: rgba(255,255,255,.15); }
    </style>
    <script>
            window.API_BASE_URL = 'https://localhost:7254';
    </script>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-file-contract"></i> TechMove
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto" id="navMenu"></ul>

                <ul class="navbar-nav align-items-center gap-2">
                    <!-- API button: always visible to logged-in users of ANY role -->
                    <li class="nav-item" id="apiLink" style="display:none;">
                        <a class="nav-link text-warning api-btn px-3 rounded fw-semibold"
                           href="https://localhost:7254/swagger" target="_blank" title="Open Swagger / OpenAPI explorer">
                            <i class="fas fa-code me-1"></i> API
                        </a>
                    </li>

                    <li class="nav-item" id="loginLink">
                        <a class="nav-link text-light" href="/Account/Login">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    </li>
                    <li class="nav-item" id="userInfo" style="display:none;">
                        <span class="nav-link text-light">
                            <i class="fas fa-user"></i> <span id="userNameSpan"></span>
                        </span>
                    </li>
                    <li class="nav-item" id="logoutLink" style="display:none;">
                        <a class="nav-link text-light" href="#" onclick="logout()">
                            <i class="fas fa-sign-out-alt"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-4 mt-5" style="background:#f8f9fa;">
        <div class="container">
            &copy; 2026 - TechMove &nbsp;|&nbsp;
            <a href="/swagger" target="_blank" class="text-muted text-decoration-none">
                <i class="fas fa-code me-1"></i>API Docs
            </a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function updateNav() {
            const token    = localStorage.getItem('token');
            const role     = localStorage.getItem('role');
            const fullName = localStorage.getItem('fullName');

            const navMenu   = document.getElementById('navMenu');
            const loginLink = document.getElementById('loginLink');
            const logoutLink = document.getElementById('logoutLink');
            const userInfo  = document.getElementById('userInfo');
            const apiLink   = document.getElementById('apiLink');

            if (token && role) {
                loginLink.style.display  = 'none';
                logoutLink.style.display = 'block';
                userInfo.style.display   = 'block';
                apiLink.style.display    = 'block'; // Visible for ALL roles

                document.getElementById('userNameSpan').textContent = fullName || 'User';

                if (role === 'Admin') {
                    navMenu.innerHTML = `
                        <li class="nav-item"><a class="nav-link text-light" href="/Admin/Dashboard"><i class="fas fa-tachometer-alt me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Admin/Contracts"><i class="fas fa-file-contract me-1"></i>Contracts</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Admin/ServiceRequests"><i class="fas fa-tasks me-1"></i>Requests</a></li>
                    `;
                } else if (role === 'Client') {
                    navMenu.innerHTML = `
                        <li class="nav-item"><a class="nav-link text-light" href="/Client/Dashboard"><i class="fas fa-tachometer-alt me-1"></i>Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Client/ClientContracts"><i class="fas fa-file-contract me-1"></i>My Contracts</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Client/Requests"><i class="fas fa-tasks me-1"></i>My Requests</a></li>
                    `;
                }
            }
        }

        function logout() {
            localStorage.clear();
            window.location.replace('/Account/Login');
        }

        updateNav();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
