<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TechMove</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
            .api-btn {
                border: 1px solid rgba(255,255,255,.4);
            }

                .api-btn:hover {
                    background: rgba(255,255,255,.15);
                }
    </style>
</head>
<body>
    @using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
        var token = HttpContextAccessor.HttpContext?.Session.GetString("JwtToken");
        var role = HttpContextAccessor.HttpContext?.Session.GetString("UserRole");
        var fullName = HttpContextAccessor.HttpContext?.Session.GetString("FullName");
    }

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="fas fa-file-contract"></i> TechMove
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    @if (!string.IsNullOrEmpty(token) && role == "Admin")
                    {
                        <li class="nav-item"><a class="nav-link text-light" href="/Admin/Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Admin/Contracts">Contracts</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Admin/ServiceRequests">Requests</a></li>
                    }
                    else if (!string.IsNullOrEmpty(token) && role == "Client")
                    {
                        <li class="nav-item"><a class="nav-link text-light" href="/Client/Dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Client/ClientContracts">My Contracts</a></li>
                        <li class="nav-item"><a class="nav-link text-light" href="/Client/Requests">My Requests</a></li>
                    }
                </ul>

                <ul class="navbar-nav align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(token))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning api-btn px-3 rounded fw-semibold"
                               href="http://localhost:5000/swagger" target="_blank">
                                <i class="fas fa-code me-1"></i> API
                            </a>
                        </li>
                        <li class="nav-item">
                            <span class="nav-link text-light"><i class="fas fa-user"></i> @fullName</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-light" href="/Account/Login"><i class="fas fa-sign-in-alt"></i> Login</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-4 mt-5" style="background:#f8f9fa;">
        <div class="container">
            &copy; 2026 - TechMove &nbsp;|&nbsp;
            <a href="http://localhost:5000/swagger" target="_blank" class="text-muted text-decoration-none">
                <i class="fas fa-code me-1"></i>API Docs
            </a>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
