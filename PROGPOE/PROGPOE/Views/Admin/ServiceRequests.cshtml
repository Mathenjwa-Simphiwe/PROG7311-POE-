@model List<PROGPOE.ViewModels.ServiceRequestViewModel>
@{
    ViewData["Title"] = "Service Requests";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-clipboard-list me-2"></i>Service Requests</h2>
</div>

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-auto">
            <label>Filter by Status:</label>
            <select name="status" class="form-select" onchange="this.form.submit()">
                <option value="">All</option>
                <option value="0" selected="@(Context.Request.Query["status"] == "0")">Pending</option>
                <option value="1" selected="@(Context.Request.Query["status"] == "1")">Approved</option>
                <option value="2" selected="@(Context.Request.Query["status"] == "2")">InProgress</option>
                <option value="3" selected="@(Context.Request.Query["status"] == "3")">Completed</option>
                <option value="4" selected="@(Context.Request.Query["status"] == "4")">Denied</option>
            </select>
        </div>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Contract</th>
                        <th>Client</th>
                        <th>Description</th>
                        <th>Cost (ZAR)</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><small class="text-muted">@r.RequestId</small></td>
                            <td>@r.Type</td>
                            <td>@r.ContractNumber</td>
                            <td>@r.ClientName</td>
                            <td>@r.Description</td>
                            <td>@(r.LocalCostZar.HasValue ? $"R {r.LocalCostZar.Value:F2}" : (r.Cost.HasValue ? $"R {r.Cost.Value:F2}" : "—"))</td>
                            <td>
                                <span class="badge bg-@(r.Status == "Pending" ? "warning" : r.Status == "Approved" ? "success" : "danger")">
                                    @r.Status
                                </span>
                            </td>
                            <td class="d-flex gap-1">
                                @if (r.Status == "Pending")
                                {
                                    <form method="post" action="/Admin/ApproveRequest" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.ServiceRequestId" />
                                        <button type="submit" class="btn btn-sm btn-success"><i class="fas fa-check"></i></button>
                                    </form>
                                    <form method="post" action="/Admin/DeclineRequest" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.ServiceRequestId" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-times"></i></button>
                                    </form>
                                }
                                <form method="post" action="/Admin/DeleteServiceRequest" onsubmit="return confirm('Delete request @r.RequestId?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.ServiceRequestId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>