@model PROGPOE.ViewModels.ContractViewModel
@{
    ViewData["Title"] = "Edit Contract";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-edit me-2"></i>Edit Contract</h2>
    <a href="/Admin/Contracts" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Back to Contracts
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card shadow-sm">
    <div class="card-header">
        <strong>@Model.ContractNumber</strong>
        <span class="badge bg-secondary ms-2">@Model.ServiceLevel</span>
        <span class="badge bg-@(Model.Status == "Active" ? "success" : "warning") ms-1">@Model.Status</span>
    </div>
    <div class="card-body">
        <form method="post" action="/Admin/EditContract">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ContractId" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                    <input type="date" name="startDate" class="form-control"
                           value="@Model.StartDate.ToString("yyyy-MM-dd")" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">End Date <span class="text-danger">*</span></label>
                    <input type="date" name="endDate" class="form-control"
                           value="@Model.EndDate.ToString("yyyy-MM-dd")" required>
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold">Service Level <span class="text-danger">*</span></label>
                    <select name="serviceLevel" class="form-select" required>
                        <option value="0" selected="@(Model.ServiceLevel == "Standard")">Standard</option>
                        <option value="1" selected="@(Model.ServiceLevel == "Premium")">Premium</option>
                        <option value="2" selected="@(Model.ServiceLevel == "Enterprise")">Enterprise</option>
                    </select>
                </div>
            </div>

            <hr class="my-4">
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
                <a href="/Admin/Contracts" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
