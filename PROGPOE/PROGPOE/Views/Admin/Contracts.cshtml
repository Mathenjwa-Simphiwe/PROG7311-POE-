@model List<PROGPOE.ViewModels.ContractViewModel>
@{
    ViewData["Title"] = "Manage Contracts";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-contract me-2"></i>Contract Management</h2>
    <a href="/Admin/Contracts/Create" class="btn btn-success">
        <i class="fas fa-plus-circle me-2"></i>Create New Contract
    </a>
</div>

<!-- Filter Form -->
<form method="get" class="card mb-4">
    <div class="card-header"><h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filter Contracts</h5></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Start Date</label>
                <input type="date" name="startDate" class="form-control" value="@Context.Request.Query["startDate"]">
            </div>
            <div class="col-md-4">
                <label class="form-label">End Date</label>
                <input type="date" name="endDate" class="form-control" value="@Context.Request.Query["endDate"]">
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="0" selected="@(Context.Request.Query["status"] == "0")">Draft</option>
                    <option value="1" selected="@(Context.Request.Query["status"] == "1")">Active</option>
                    <option value="2" selected="@(Context.Request.Query["status"] == "2")">Expired</option>
                    <option value="3" selected="@(Context.Request.Query["status"] == "3")">On Hold</option>
                    <option value="4" selected="@(Context.Request.Query["status"] == "4")">Terminated</option>
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </div>
</form>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Contract #</th>
                        <th>Client</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Level</th>
                        <th>Status</th>
                        <th>PDF</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><strong>@c.ContractNumber</strong></td>
                            <td>@c.ClientName</td>
                            <td>@c.StartDate.ToShortDateString()</td>
                            <td>@c.EndDate.ToShortDateString()</td>
                            <td><span class="badge bg-secondary">@c.ServiceLevel</span></td>
                            <td><span class="badge bg-@(c.Status == "Active" ? "success" : c.Status == "Expired" ? "danger" : "warning")">@c.Status</span></td>
                            <td>
                                @if (c.HasAgreement)
                                {
                                    <a href="https://localhost:7254/api/contracts/@c.ContractId/download" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-download"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">None</span>
                                }
                            </td>
                            <td class="d-flex gap-1">
                                <form method="post" action="/Admin/Contracts/UpdateStatus" class="d-inline">
                                    <input type="hidden" name="id" value="@c.ContractId" />
                                    <select name="status" class="form-select form-select-sm d-inline w-auto">
                                        <option value="0">Draft</option>
                                        <option value="1">Active</option>
                                        <option value="2">Expired</option>
                                        <option value="3">On Hold</option>
                                        <option value="4">Terminated</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-warning"><i class="fas fa-exchange-alt"></i></button>
                                </form>
                                <a href="/Admin/Contracts/Edit/@c.ContractId" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                                <form method="post" action="/Admin/Contracts/Delete" onsubmit="return confirm('Delete contract @c.ContractNumber?')">
                                    <input type="hidden" name="id" value="@c.ContractId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>