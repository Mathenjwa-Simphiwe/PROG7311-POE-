@{
    ViewData["Title"] = "Manage Contracts";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-contract me-2"></i>Contract Management</h2>
    <button class="btn btn-success" onclick="openCreateModal()">
        <i class="fas fa-plus-circle me-2"></i>Create New Contract
    </button>
</div>

<!-- Filter Card -->
<div class="card mb-4">
    <div class="card-header"><h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filter Contracts</h5></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Start Date</label>
                <input type="date" id="filterStart" class="form-control">
            </div>
            <div class="col-md-4">
                <label class="form-label">End Date</label>
                <input type="date" id="filterEnd" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select id="filterStatus" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="0">Draft</option>
                    <option value="1">Active</option>
                    <option value="2">Expired</option>
                    <option value="3">On Hold</option>
                    <option value="4">Terminated</option>
                </select>
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button class="btn btn-primary w-100" onclick="loadContracts()"><i class="fas fa-search"></i></button>
            </div>
        </div>
    </div>
</div>

<div id="alertArea"></div>

<!-- Contracts Table -->
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Contract #</th><th>Client</th><th>Start</th><th>End</th>
                        <th>Level</th><th>Status</th><th>PDF</th><th>Actions</th>
                    </tr>
                </thead>
                <tbody id="contractsBody">
                    <tr><td colspan="8" class="text-center py-4">
                        <div class="spinner-border text-primary"></div><p class="mt-2 mb-0">Loading...</p>
                    </td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CREATE MODAL -->
<div class="modal fade" id="createModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="fas fa-plus-circle me-2"></i>Create New Contract</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="createAlert"></div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Client <span class="text-danger">*</span></label>
                    <select id="clientSelect" class="form-select"></select>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                        <input type="date" id="cStartDate" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">End Date <span class="text-danger">*</span></label>
                        <input type="date" id="cEndDate" class="form-control">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Service Level <span class="text-danger">*</span></label>
                    <select id="cServiceLevel" class="form-select">
                        <option value="0">Standard</option>
                        <option value="1">Premium</option>
                        <option value="2">Enterprise</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Signed Agreement (PDF)</label>
                    <input type="file" id="cAgreement" class="form-control" accept=".pdf">
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-success" id="createBtn" onclick="submitCreate()">
                    <i class="fas fa-save me-2"></i>Create Contract
                </button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT MODAL (PUT) -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Edit Contract</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="editAlert"></div>
                <p class="mb-2 text-muted">Contract: <strong id="editContractNumber"></strong></p>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Start Date</label>
                        <input type="date" id="eStartDate" class="form-control">
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">End Date</label>
                        <input type="date" id="eEndDate" class="form-control">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Service Level</label>
                    <select id="eServiceLevel" class="form-select">
                        <option value="0">Standard</option>
                        <option value="1">Premium</option>
                        <option value="2">Enterprise</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="submitEdit()"><i class="fas fa-save me-2"></i>Save Changes</button>
            </div>
        </div>
    </div>
</div>

<!-- STATUS MODAL (PATCH) -->
<div class="modal fade" id="statusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exchange-alt me-2"></i>Update Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Contract: <strong id="statusContractNumber"></strong></p>
                <select id="newStatus" class="form-select">
                    <option value="0">Draft</option>
                    <option value="1">Active</option>
                    <option value="2">Expired</option>
                    <option value="3">On Hold</option>
                    <option value="4">Terminated</option>
                </select>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-warning" onclick="submitStatusChange()"><i class="fas fa-check me-2"></i>Update</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const token = localStorage.getItem('token');
    const role  = localStorage.getItem('role');
    if (!token || role !== 'Admin') { window.location.href = '/Account/Login'; }

    let currentId = null;

    const statusBadge = s => {
        const m = { Draft:'secondary', Active:'success', Expired:'danger', 'On Hold':'warning', OnHold:'warning', Terminated:'dark' };
        return `<span class="badge bg-${m[s]||'secondary'}">${s}</span>`;
    };
    const levelBadge = l => {
        const m = { Standard:'info', Premium:'primary', Enterprise:'dark' };
        return `<span class="badge bg-${m[l]||'secondary'}">${l}</span>`;
    };
    const fmtDate = d => new Date(d).toLocaleDateString();
    const svMap   = { Draft:'0', Active:'1', Expired:'2', OnHold:'3', 'On Hold':'3', Terminated:'4' };
    const slMap   = { Standard:'0', Premium:'1', Enterprise:'2' };

        async function authFetch(url, opts = {}) {
        const fullUrl = url.startsWith('http') ? url : window.API_BASE_URL + url;
        return fetch(fullUrl, { ...opts, headers: { 'Authorization': 'Bearer ' + token, ...(opts.headers||{}) } });

    function showAlert(type, html, area = 'alertArea') {
        document.getElementById(area).innerHTML =
            `<div class="alert alert-${type} alert-dismissible fade show">${html}<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>`;
    }

    // ── LOAD (GET) ──────────────────────────────────────────────────
    async function loadContracts() {
        const body = document.getElementById('contractsBody');
        body.innerHTML = '<tr><td colspan="8" class="text-center py-4"><div class="spinner-border text-primary"></div></td></tr>';

        const p = new URLSearchParams();
        const s = document.getElementById('filterStart').value;
        const e = document.getElementById('filterEnd').value;
        const st = document.getElementById('filterStatus').value;
        if (s)  p.append('startDate', s);
        if (e)  p.append('endDate', e);
        if (st !== '') p.append('status', st);

        try {
            const res = await authFetch('/api/contracts?' + p);
            if (!res.ok) { body.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Failed to load.</td></tr>'; return; }
            const list = await res.json();
            if (!list.length) {
                body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4"><i class="fas fa-inbox fa-2x d-block mb-2"></i>No contracts found.</td></tr>';
                return;
            }
            body.innerHTML = list.map(c => `
                <tr>
                    <td><strong>${c.contractNumber}</strong></td>
                    <td>${c.clientName || '<span class="text-muted">—</span>'}</td>
                    <td>${fmtDate(c.startDate)}</td>
                    <td>${fmtDate(c.endDate)}</td>
                    <td>${levelBadge(c.serviceLevel)}</td>
                    <td>${statusBadge(c.status)}</td>
                    <td>${c.hasAgreement
                        ? `<a href="/api/admin/contracts/${c.contractId}/download" target="_blank" class="btn btn-sm btn-outline-primary"><i class="fas fa-download"></i></a>`
                        : '<span class="text-muted small">None</span>'}</td>
                    <td class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-secondary" title="PATCH Status"
                            onclick="openStatusModal(${c.contractId},'${c.contractNumber}','${c.status}')">
                            <i class="fas fa-exchange-alt"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" title="PUT Edit"
                            onclick="openEditModal(${c.contractId},'${c.contractNumber}','${c.startDate}','${c.endDate}','${c.serviceLevel}')">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-outline-danger" title="DELETE"
                            onclick="deleteContract(${c.contractId},'${c.contractNumber}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>`).join('');
        } catch { body.innerHTML = '<tr><td colspan="8" class="text-center text-danger py-4">Network error.</td></tr>'; }
    }

    // ── CREATE (POST) ───────────────────────────────────────────────
    async function loadClients() {
        const sel = document.getElementById('clientSelect');
        sel.innerHTML = '<option value="">Loading...</option>';
        const res = await authFetch('/api/clients');
        const clients = res.ok ? await res.json() : [];
        sel.innerHTML = clients.length
            ? '<option value="">— Select client —</option>' + clients.map(c => `<option value="${c.id}">${c.fullName} (${c.email})</option>`).join('')
            : '<option value="">No clients found</option>';
    }

    function openCreateModal() {
        document.getElementById('cStartDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('cEndDate').value   = '';
        document.getElementById('cServiceLevel').value = '0';
        document.getElementById('cAgreement').value = '';
        document.getElementById('createAlert').innerHTML = '';
        const btn = document.getElementById('createBtn');
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save me-2"></i>Create Contract';
        loadClients();
        new bootstrap.Modal(document.getElementById('createModal')).show();
    }

    async function submitCreate() {
        const alertEl = document.getElementById('createAlert');
        const clientId = document.getElementById('clientSelect').value;
        const startDate = document.getElementById('cStartDate').value;
        const endDate   = document.getElementById('cEndDate').value;
        const serviceLevel = document.getElementById('cServiceLevel').value;
        const agreementFile = document.getElementById('cAgreement').files[0];

        if (!clientId)  { alertEl.innerHTML = '<div class="alert alert-danger">Please select a client.</div>'; return; }
        if (!startDate || !endDate) { alertEl.innerHTML = '<div class="alert alert-danger">Please fill in both dates.</div>'; return; }
        if (new Date(endDate) <= new Date(startDate)) { alertEl.innerHTML = '<div class="alert alert-danger">End date must be after start date.</div>'; return; }

        const btn = document.getElementById('createBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Creating...';

        const fd = new FormData();
        fd.append('ClientId', clientId);
        fd.append('StartDate', startDate);
        fd.append('EndDate', endDate);
        fd.append('ServiceLevel', serviceLevel);
        if (agreementFile) fd.append('Agreement', agreementFile);

        try {
            const res  = await authFetch('/api/contracts', { method: 'POST', body: fd });
            const data = await res.json();
            if (res.ok) {
                bootstrap.Modal.getInstance(document.getElementById('createModal')).hide();
                showAlert('success', `<i class="fas fa-check-circle me-2"></i>Contract <strong>${data.contractNumber}</strong> created!`);
                loadContracts();
            } else {
                alertEl.innerHTML = `<div class="alert alert-danger">${data.message || 'Failed to create.'}</div>`;
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-save me-2"></i>Create Contract';
            }
        } catch {
            alertEl.innerHTML = '<div class="alert alert-danger">Network error.</div>';
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-save me-2"></i>Create Contract';
        }
    }

    // ── EDIT (PUT) ──────────────────────────────────────────────────
    function openEditModal(id, number, startDate, endDate, serviceLevel) {
        currentId = id;
        document.getElementById('editContractNumber').textContent = number;
        document.getElementById('eStartDate').value    = startDate.split('T')[0];
        document.getElementById('eEndDate').value      = endDate.split('T')[0];
        document.getElementById('eServiceLevel').value = slMap[serviceLevel] || '0';
        document.getElementById('editAlert').innerHTML = '';
        new bootstrap.Modal(document.getElementById('editModal')).show();
    }

    async function submitEdit() {
        if (!currentId) return;
        const body = {
            startDate:    document.getElementById('eStartDate').value,
            endDate:      document.getElementById('eEndDate').value,
            serviceLevel: parseInt(document.getElementById('eServiceLevel').value)
        };
        try {
            const res  = await authFetch(`/api/contracts/${currentId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const data = await res.json();
            bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
            showAlert(res.ok ? 'success' : 'danger', data.message || (res.ok ? 'Contract updated.' : 'Update failed.'));
            if (res.ok) loadContracts();
        } catch { showAlert('danger', 'Network error.'); }
    }

    // ── STATUS (PATCH) ──────────────────────────────────────────────
    function openStatusModal(id, number, currentStatus) {
        currentId = id;
        document.getElementById('statusContractNumber').textContent = number;
        document.getElementById('newStatus').value = svMap[currentStatus] || '0';
        new bootstrap.Modal(document.getElementById('statusModal')).show();
    }

    async function submitStatusChange() {
        if (!currentId) return;
        try {
            const res  = await authFetch(`/api/contracts/${currentId}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status: parseInt(document.getElementById('newStatus').value) })
            });
            const data = await res.json();
            bootstrap.Modal.getInstance(document.getElementById('statusModal')).hide();
            showAlert(res.ok ? 'success' : 'danger', data.message || (res.ok ? 'Status updated.' : 'Failed.'));
            if (res.ok) loadContracts();
        } catch { showAlert('danger', 'Network error.'); }
    }

    // ── DELETE ──────────────────────────────────────────────────────
    async function deleteContract(id, number) {
        if (!confirm(`Delete contract ${number}? This cannot be undone.`)) return;
        try {
            const res  = await authFetch(`/api/contracts/${id}`, { method: 'DELETE' });
            const data = await res.json();
            showAlert(res.ok ? 'success' : 'danger', data.message || (res.ok ? 'Deleted.' : 'Delete failed.'));
            if (res.ok) loadContracts();
        } catch { showAlert('danger', 'Network error.'); }
    }

    loadContracts();
</script>
}
