@model List<PROGPOE.ViewModels.ContractViewModel>
@{
    ViewData["Title"] = "My Contracts";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-file-contract me-2"></i>My Contracts</h2>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<form method="get" class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <label class="col-form-label fw-semibold">Filter by Status:</label>
            </div>
            <div class="col-auto">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All</option>
                    <option value="0" selected="@(Context.Request.Query["status"] == "0")">Draft</option>
                    <option value="1" selected="@(Context.Request.Query["status"] == "1")">Active</option>
                    <option value="2" selected="@(Context.Request.Query["status"] == "2")">Expired</option>
                    <option value="3" selected="@(Context.Request.Query["status"] == "3")">On Hold</option>
                </select>
            </div>
        </div>
    </div>
</form>

<div class="row">
    @if (!Model.Any())
    {
        <div class="col-12"><div class="alert alert-info"><i class="fas fa-inbox me-2"></i>No contracts found.</div></div>
    }
    else
    {
        foreach (var c in Model)
        {
            var statusClass = c.Status == "Active" ? "success" : c.Status == "Expired" ? "danger" : c.Status == "On Hold" ? "warning" : "secondary";
            <div class="col-md-6 mb-3">
                <div class="card h-100 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@c.ContractNumber</strong>
                        <span class="badge bg-@statusClass">@c.Status</span>
                    </div>
                    <div class="card-body">
                        <p><i class="fas fa-calendar-alt me-2 text-muted"></i>Start: @c.StartDate.ToShortDateString()</p>
                        <p><i class="fas fa-calendar-check me-2 text-muted"></i>End: @c.EndDate.ToShortDateString()</p>
                        <p><i class="fas fa-layer-group me-2 text-muted"></i>Level: @c.ServiceLevel</p>
                    </div>
                    <div class="card-footer bg-transparent">
                        @if (c.Status == "Draft")
                        {
                            <form method="post" action="/Client/SignContract" onsubmit="return confirm('Sign and activate contract @c.ContractNumber?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@c.ContractId" />
                                <button type="submit" class="btn btn-sm btn-success w-100">
                                    <i class="fas fa-signature me-2"></i>Sign & Activate
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">
                                <i class="fas fa-info-circle me-1"></i>
                                @(c.Status == "Active" ? "Contract is active — raise requests from My Requests." : "Contract is " + c.Status.ToLower() + ".")
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>