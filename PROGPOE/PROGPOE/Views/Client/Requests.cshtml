@model List<PROGPOE.ViewModels.ServiceRequestViewModel>
@{
    ViewData["Title"] = "My Service Requests";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tasks me-2"></i>My Service Requests</h2>
    <button class="btn btn-primary" onclick="openCreateModal()">
        <i class="fas fa-plus-circle me-2"></i>Raise New Request
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Type</th>
                        <th>Contract</th>
                        <th>Description</th>
                        <th>Base Cost</th>
                        <th>USD</th>
                        <th>ZAR</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><small class="text-muted">@r.RequestId</small></td>
                            <td>@r.Type</td>
                            <td>@r.ContractNumber</td>
                            <td>@r.Description</td>
                            <td>@(r.Cost.HasValue ? $"R {r.Cost.Value:F2}" : "—")</td>
                            <td>@(r.LocalCostZar.HasValue ? "$ " + (r.LocalCostZar.Value / 19).ToString("F2") : "—")</td>
                            <td>@(r.LocalCostZar.HasValue ? $"R {r.LocalCostZar.Value:F2}" : "—")</td>
                            <td><span class="badge bg-@(r.Status == "Pending" ? "warning" : r.Status == "Approved" ? "success" : "secondary")">@r.Status</span></td>
                            <td class="d-flex gap-1">
                                @if (r.Status == "Pending")
                                {
                                    <button class="btn btn-sm btn-outline-warning" onclick="openEdit(@r.ServiceRequestId, '@r.Description.Replace("'", "\\'")')"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteRequest(@r.ServiceRequestId, '@r.RequestId')"><i class="fas fa-trash"></i></button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CREATE MODAL -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Raise New Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="createAlert"></div>
                <form id="createForm">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label>Contract</label>
                        <select id="contractId" class="form-select" required></select>
                    </div>
                    <div class="mb-3">
                        <label>Request Type</label>
                        <select id="requestType" class="form-select" onchange="toggleFields()">
                            <option value="0">Freight</option>
                            <option value="1">Maintenance</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label>Origin</label>
                        <input type="text" id="origin" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label>Description</label>
                        <textarea id="description" class="form-control" rows="2" required></textarea>
                    </div>
                    <div id="freightFields">
                        <div class="row">
                            <div class="col-md-6"><label>Destination</label><input type="text" id="destination" class="form-control"></div>
                            <div class="col-md-6"><label>Weight (kg)</label><input type="number" id="weight" class="form-control" step="0.1"></div>
                        </div>
                    </div>
                    <div id="maintFields" style="display:none;">
                        <div class="row">
                            <div class="col-md-6"><label>Equipment Type</label><input type="text" id="equipment" class="form-control"></div>
                            <div class="col-md-6"><label>Estimated Hours</label><input type="number" id="hours" class="form-control"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label>USD Amount (optional)</label>
                        <input type="number" id="usdAmount" class="form-control" step="0.01">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" onclick="submitCreate()">Submit</button>
            </div>
        </div>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title">Edit Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="editId" />
                    <div class="mb-3">
                        <label>Origin</label>
                        <input type="text" id="editOrigin" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label>Description</label>
                        <textarea id="editDescription" class="form-control" rows="3" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-warning" onclick="submitEdit()">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Load contracts for the create dropdown
    async function loadContracts() {
        const response = await fetch('/Client/Requests/GetContracts');
        const contracts = await response.json();
        const sel = document.getElementById('contractId');
        sel.innerHTML = contracts.map(c => `<option value="${c.contractId}">${c.contractNumber} (${c.status})</option>`).join('');
    }

    function toggleFields() {
        const type = document.getElementById('requestType').value;
        document.getElementById('freightFields').style.display = type === '0' ? 'block' : 'none';
        document.getElementById('maintFields').style.display = type === '1' ? 'block' : 'none';
    }

    function openCreateModal() {
        loadContracts();
        document.getElementById('createForm').reset();
        document.getElementById('createAlert').innerHTML = '';
        new bootstrap.Modal(document.getElementById('createModal')).show();
    }

    async function submitCreate() {
        const data = {
            contractId: parseInt(document.getElementById('contractId').value),
            type: parseInt(document.getElementById('requestType').value),
            origin: document.getElementById('origin').value,
            description: document.getElementById('description').value,
            destination: document.getElementById('destination').value,
            weightKg: parseFloat(document.getElementById('weight').value) || null,
            equipmentType: document.getElementById('equipment').value,
            estimatedHours: parseInt(document.getElementById('hours').value) || null,
            usdAmount: parseFloat(document.getElementById('usdAmount').value) || null
        };
        const response = await fetch('/Client/Requests/Create', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
            body: JSON.stringify(data)
        });
        const result = await response.json();
        if (response.ok) {
            location.reload();
        } else {
            document.getElementById('createAlert').innerHTML = `<div class="alert alert-danger">${result.message || 'Error'}</div>`;
        }
    }

    function openEdit(id, description) {
        document.getElementById('editId').value = id;
        document.getElementById('editDescription').value = description;
        new bootstrap.Modal(document.getElementById('editModal')).show();
    }

    async function submitEdit() {
        const id = document.getElementById('editId').value;
        const data = {
            origin: document.getElementById('editOrigin').value,
            description: document.getElementById('editDescription').value
        };
        const response = await fetch(`/Client/Requests/Edit/${id}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]') },
            body: JSON.stringify(data)
        });
        if (response.ok) location.reload();
        else alert('Error updating request');
    }

    async function deleteRequest(id, reqId) {
        if (!confirm(`Cancel request ${reqId}?`)) return;
        const response = await fetch(`/Client/Requests/Delete/${id}`, { method: 'POST', headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]') } });
        if (response.ok) location.reload();
        else alert('Error deleting request');
    }

    toggleFields();
</script>