# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project file and restore dependencies
COPY TechMoveAPI/TechMoveAPI.csproj TechMoveAPI/
RUN dotnet restore TechMoveAPI/TechMoveAPI.csproj

# Copy all source and publish
COPY TechMoveAPI/ TechMoveAPI/
RUN dotnet publish TechMoveAPI/TechMoveAPI.csproj -c Release -o /app/publish

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

COPY --from=build /app/publish .

# Create a folder for uploaded agreement PDFs
RUN mkdir -p /app/uploads

EXPOSE 8080
ENTRYPOINT ["dotnet", "TechMoveAPI.dll"]
